{
	// 開発・E2E 専用の Wrangler 設定。デプロイ設定は cloudflare.config.ts が持つ。
	// vite dev のバインディング(getPlatformProxy)と adapter-cloudflare、wrangler dev は
	// cloudflare.config.ts を読めないため残している。Wrangler が自動で探さない名前にして、
	// workers/cleanup で親の設定を拾う不具合(workers-sdk#16002)を避ける
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "pasu",
	"compatibility_date": "2026-07-12",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pasu",
			"database_id": "f3c0e812-aaa5-4575-a6ab-df63dce70350",
			"migrations_dir": "migrations"
		}
	]
}
